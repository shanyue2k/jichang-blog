---
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../site.config';
import { absoluteUrl } from '../lib/content';

interface Props {
  /** 页面标题，不含站点名；首页传 fullTitle */
  title?: string;
  fullTitle?: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: (Record<string, unknown> | null | undefined)[];
  published?: Date;
  modified?: Date;
}

const { title, fullTitle, description, type = 'website', noindex = false, jsonLd = [], published, modified } =
  Astro.props;

const pageTitle = fullTitle ?? (title ? `${title} - ${SITE.name}` : SITE.name);
const canonical = absoluteUrl(Astro.url.pathname);
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1d2833" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}

    {SITE.verification.bing && <meta name="msvalidate.01" content={SITE.verification.bing} />}
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}

    <JsonLd data={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
