---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostList from '../../components/PostList.astro';
import { PILLAR, SECTION_KEYS, SECTIONS, type SectionKey } from '../../site.config';
import { getPosts, sectionPath } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return SECTION_KEYS.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionKey;
const meta = SECTIONS[section];
const posts = await getPosts(section);
const crumbs = [
  { name: '首页', path: '/' },
  { name: meta.label, path: sectionPath(section) },
];
---

<Base title={meta.title} description={meta.description} jsonLd={[breadcrumbSchema(crumbs)]} noindex={posts.length === 0}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <header class="head">
      <h1>{meta.label}</h1>
      <p class="lead">{meta.description}</p>
    </header>
    {
      posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <p class="empty">
          这个栏目还没有文章。在 <code>src/content/{section}/</code> 新建一个 .md 文件就会出现在这里。想先挑机场，可以看
          <a href={PILLAR.path}>{PILLAR.label}榜单</a>。
        </p>
      )
    }
  </div>
</Base>

<style>
  .head {
    max-width: 48rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink);
  }

  .lead {
    color: var(--ink-soft);
    margin: 0;
  }

  .empty {
    max-width: 40rem;
    color: var(--ink-soft);
  }
</style>
