---
// 资料页的「站长实测」区块：数据来自资料文件 tests[0]
import type { TestRun } from '../lib/profiles';

interface Props {
  name: string;
  test: TestRun;
}
const { name, test } = Astro.props;
const max = Math.max(...test.regions.map((r) => r.avgMBps));
const ageDays = Math.round((Date.now() - new Date(test.date + 'T12:00:00+08:00').getTime()) / 86400000);
const stale = ageDays > 60;
const total = test.regions.reduce((s, r) => s + r.nodes, 0);
const failed = test.regions.reduce((s, r) => s + r.failed, 0);
---

<section class="test" aria-labelledby="test-title">
  <div class="card-head">
    <h2 id="test-title">{name}实测</h2>
    <p class="date">{test.date}{test.time ? ' ' + test.time : ''} 实测</p>
  </div>
  <p class="env">{test.env} · {test.tool} · {test.tester}</p>
  {stale && <p class="stale">这份测试距今已有一段时间，机场线路可能有调整，结果仅供参考。</p>}

  <ul class="rows" aria-label="各地区实测结果">
    {test.regions.map((r) => (
      <li>
        <span class="r-name">{r.name}<small>{r.nodes} 个节点{r.failed ? ' · ' + r.failed + ' 个失败' : ''}</small></span>
        <span class="r-bar" aria-hidden="true"><span style={'width:' + Math.max(2, (r.avgMBps / max) * 100) + '%'}></span></span>
        <span class="r-rtt">延迟 <b class="num">{r.medianRttMs}</b> ms</span>
        <span class="r-speed">
          <b class="num">{r.avgMBps}</b> MB/s
          <small>≈ {Math.round(r.avgMBps * 8).toLocaleString('en-US')} Mbps</small>
        </span>
      </li>
    ))}
  </ul>

  {test.unlock && (
    <p class="unlock">
      {Object.entries(test.unlock).map(([k, v]) => (
        <span><strong>{k}</strong> {v}</span>
      ))}
      {test.unlockNote && <small>{test.unlockNote}</small>}
    </p>
  )}

  {test.notes && (
    <ul class="notes">
      {test.notes.map((n) => <li>{n}。</li>)}
    </ul>
  )}

  {test.images && (
    <details class="shots">
      <summary>查看原始测速截图（{test.images.length} 张，保留测速工具水印）</summary>
      <div class="shot-grid">
        {test.images.map((img) => (
          <figure>
            <a href={img.src} target="_blank" rel="noopener"><img src={img.src} alt={img.alt} width="1200" loading="lazy" decoding="async" /></a>
            {img.caption && <figcaption>{img.caption}（点击看大图）</figcaption>}
          </figure>
        ))}
      </div>
    </details>
  )}
  <p class="foot">速度为测试服务器 {total} 个节点逐个测速的平均值（多线程，代表带宽上限），延迟为中位数。1 MB/s ≈ 8 Mbps。结果只代表测试当时、测试服务器所在网络的情况。<a href="/ceping-fangfa/">测评方法</a></p>
</section>

<style>
  .test {
    margin: 2rem 0;
    padding: 1.1rem clamp(1rem, 3vw, 1.4rem) 0.9rem;
    background: var(--slate);
    color: #e6eaee;
    border-radius: var(--radius-md);
    box-shadow: 5px 5px 0 var(--sign);
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .test h2 {
    margin: 0;
    padding: 0 !important;
    border: 0 !important;
    color: #fff;
    font-size: var(--step-1);
  }

  .date {
    margin: 0;
    font-size: 0.875rem;
    color: var(--sign);
    font-weight: 700;
  }

  .env {
    margin: 0.2rem 0 0.8rem;
    font-size: 0.8125rem;
    color: #aab4be;
  }

  .stale {
    margin: 0 0 0.8rem;
    padding: 0.4rem 0.7rem;
    background: rgba(255, 204, 0, 0.12);
    border: 1px solid rgba(255, 204, 0, 0.45);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: #ffe58a;
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rows li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) 6.2rem 8.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.6rem 0;
    border-top: 1px solid #33404d;
  }

  .r-name {
    font-weight: 700;
    color: #fff;
  }

  .r-name small {
    display: block;
    font-weight: 400;
    font-size: 0.75rem;
    color: #8f9aa5;
  }

  .r-bar {
    height: 0.55rem;
    background: #2c3846;
    border-radius: 3px;
    overflow: hidden;
  }

  .r-bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #ff8a00, #ffcc00);
  }

  .r-rtt {
    font-size: 0.875rem;
    color: #cfd6dd;
    text-align: right;
    white-space: nowrap;
  }

  .r-speed {
    text-align: right;
    white-space: nowrap;
    color: #cfd6dd;
    font-size: 0.875rem;
  }

  .r-speed b {
    font-size: 1.15rem;
    color: var(--sign);
  }

  .r-speed small {
    display: block;
    font-size: 0.75rem;
    color: #8f9aa5;
  }

  @media (max-width: 640px) {
    .rows li {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'name speed' 'bar bar' 'rtt rtt';
      gap: 0.3rem 0.75rem;
    }
    .r-name { grid-area: name; }
    .r-speed { grid-area: speed; }
    .r-bar { grid-area: bar; }
    .r-rtt { grid-area: rtt; text-align: left; }
  }

  .unlock {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    align-items: center;
    margin: 0.4rem 0 0.6rem;
    padding-top: 0.7rem;
    border-top: 1px solid #33404d;
  }

  .unlock span {
    padding: 0.1rem 0.55rem;
    background: rgba(31, 157, 85, 0.18);
    border: 1px solid rgba(31, 157, 85, 0.55);
    border-radius: 3px;
    font-size: 0.8125rem;
    color: #b9f0cf;
  }

  .unlock small {
    font-size: 0.75rem;
    color: #8f9aa5;
  }

  .notes {
    margin: 0.3rem 0 0.6rem;
    padding-left: 1.1em;
    font-size: 0.8125rem;
    color: #b8c2cc;
  }

  .notes li + li {
    margin-top: 0.15rem;
  }

  .shots {
    margin: 0.4rem 0;
    border: 1px solid #33404d;
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.75rem;
  }

  .shots summary {
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--sign);
    font-weight: 600;
  }

  .shot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.7rem;
  }

  @media (max-width: 640px) {
    .shot-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .shot-grid figure {
    margin: 0;
  }

  .shot-grid img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .shot-grid figcaption {
    font-size: 0.75rem;
    color: #8f9aa5;
    margin-top: 0.25rem;
  }

  .foot {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: #8f9aa5;
  }

  .foot a {
    color: #cfd6dd;
  }
</style>
