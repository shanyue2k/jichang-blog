---
import Base from '../layouts/Base.astro';
import { PILLAR, SECTION_KEYS, SECTIONS } from '../site.config';
---

<Base title="页面不存在" description="你要找的页面不存在或已移动。" noindex>
  <div class="wrap gate">
    <p class="code num">404</p>
    <h1>这个登机口不存在</h1>
    <p>页面可能已经移动或删除。可以从这里继续：</p>
    <ul>
      <li><a href={PILLAR.path}>{PILLAR.label}</a></li>
      {SECTION_KEYS.map((k) => <li><a href={`/${k}/`}>{SECTIONS[k].label}</a></li>)}
      <li><a href="/">返回首页</a></li>
    </ul>
  </div>
</Base>

<style>
  .gate {
    padding-top: 4rem;
    max-width: 40rem;
    margin-inline: auto;
  }

  .code {
    font-size: 6rem;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 0.5rem;
    color: var(--slate);
  }

  ul {
    padding-left: 1.2em;
  }
</style>
