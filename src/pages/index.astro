---
import Base from '../layouts/Base.astro';
import RankTable from '../components/RankTable.astro';
import HomePicker from '../components/HomePicker.astro';
import Spotlight from '../components/Spotlight.astro';
import TelegramCta from '../components/TelegramCta.astro';
import PostList from '../components/PostList.astro';
import { PILLAR, SECTION_KEYS, SECTIONS, SITE } from '../site.config';
import { getPairs } from '../lib/duibi';
import { getAllPosts, getPosts, sectionPath } from '../lib/content';
import { websiteSchema } from '../lib/schema';
import { formatDate } from '../lib/format';
import { FEATURED_COUNT, getRanking, monthLabel, rankingUpdated } from '../lib/ranking';

const ranking = getRanking();
const featured = ranking.slice(0, FEATURED_COUNT);
const primary = featured[0];
const secondary = featured.slice(1);
const updated = rankingUpdated(ranking);

const latest = (await getAllPosts()).slice(0, 8);
const counts = Object.fromEntries(
  await Promise.all(SECTION_KEYS.map(async (k) => [k, (await getPosts(k)).length] as const)),
);
// 对比页不是 Markdown 文章，按配对数计
counts.duibi = getPairs().length;
---

<Base fullTitle={`${SITE.homeTitle} - ${SITE.name}`} description={SITE.description} jsonLd={[websiteSchema()]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="intro">
        <h1>机场推荐 {monthLabel(updated)}</h1>
        <p>
          整理了 {ranking.length} 家机场的官网套餐价格、后台节点数量、线路和协议，每月更新。本站主推 {primary?.aff.name}，另外 {secondary.length} 家为次推，点名字可以看每家的全部套餐和怎么买最划算。
        </p>
        <p class="cta">
          <a class="btn" href={PILLAR.path}>查看完整机场推荐榜</a>
          <a class="btn btn--ghost" href="/jichang-daohang/">机场官网导航</a>
        </p>
        <p class="meta">最后更新 <time class="num" datetime={updated.toISOString()}>{formatDate(updated)}</time> · 价格以官网为准</p>
      </div>
      <div class="board-slot">
        {primary && <Spotlight item={primary} />}
      </div>
    </div>
    <div class="wrap">
      <h2 class="top-title">次推 {secondary.length} 家机场</h2>
      <RankTable items={secondary} compact caption={'次推 ' + secondary.length + ' 家机场'} />
      <p class="meta small">"折合最低"按年付等长周期换算成每月价格。官网链接为推广链接，注册价格不变。</p>
    </div>
  </section>

  <HomePicker items={featured} />

  <div class="wrap">
    <TelegramCta />
    <section class="sections" aria-labelledby="sections-title">
      <h2 id="sections-title" class="visually-hidden">栏目</h2>
      <ul>
        {
          SECTION_KEYS.map((k) => (
            <li>
              <a href={sectionPath(k)}>
                <span class="sec-name">{SECTIONS[k].label}</span>
                <span class="sec-count num">{counts[k]} 篇</span>
              </a>
              <p>{SECTIONS[k].description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="latest" aria-labelledby="latest-title">
      <h2 id="latest-title">最近更新</h2>
      {latest.length > 0 ? <PostList posts={latest} showSection headingLevel="h3" /> : <p class="meta">还没有文章。</p>}
    </section>
  </div>
</Base>

<style>
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 2.5rem 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .intro h1 {
    font-size: clamp(var(--step-3), 4vw, var(--step-4));
    line-height: 1.25;
  }

  .intro p {
    color: var(--ink-soft);
  }

  .cta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .top-title {
    margin: 1.5rem 0 0.25rem;
    font-size: var(--step-1);
  }

  .small {
    margin-top: 0.25rem;
  }

  .sections ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    border-top: 2px solid var(--ink);
  }

  @media (max-width: 860px) {
    .sections ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sections li {
    padding: 1rem 1.25rem 1rem 0;
  }

  .sections a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .sections a:hover .sec-name {
    text-decoration: underline;
  }

  .sec-name {
    font-size: var(--step-1);
    font-weight: 700;
  }

  .sec-count {
    color: var(--muted);
  }

  .sections p {
    margin: 0.3rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .latest {
    margin-top: 3rem;
  }

  .latest h2 {
    max-width: 48rem;
    border-top: 2px solid var(--ink);
    padding-top: 0.25em;
  }
</style>
