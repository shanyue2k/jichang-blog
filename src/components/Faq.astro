---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">常见问题</h2>
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  )
}

<style>
  .faq {
    max-width: var(--measure);
    margin-top: 3rem;
  }

  h2 {
    border-top: 2px solid var(--ink);
    padding-top: 0.25em;
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    cursor: pointer;
    padding: 0.8rem 2rem 0.8rem 0;
    font-weight: 600;
    list-style: none;
    position: relative;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    position: absolute;
    right: 0.25rem;
    top: 0.65rem;
    font-family: var(--font-sign);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.2s;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  details p {
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }
</style>
