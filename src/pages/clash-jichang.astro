---
// 专题：Clash 机场推荐（长尾词：clash 机场推荐 / clash 机场订阅 / clash meta 机场 / clash 机场节点 / clash 机场 免费）
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import TelegramCta from '../components/TelegramCta.astro';
import { PILLAR } from '../site.config';
import { absoluteUrl } from '../lib/content';
import { formatDate } from '../lib/format';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { FEATURED_COUNT, getRanking, monthLabel, rankingUpdated, type RankedItem } from '../lib/ranking';
import { gb, yuan } from '../lib/profiles';

const all = getRanking();
const updated = rankingUpdated(all);
const month = monthLabel(updated);
const n = all.length;
const vless = all.filter((i) => (i.profile.protocols ?? []).includes('VLESS'));
const allVless = vless.length === n;

const featured = all.slice(0, FEATURED_COUNT);
const main = all[0];
const KEY = ['香港', '台湾', '日本', '新加坡', '美国'];
const has = (i: RankedItem, r: string) => (i.profile.regions ?? []).includes(r);
const extra = (i: RankedItem) => (i.profile.regions ?? []).filter((r) => !KEY.includes(r));
const fullFive = all.filter((i) => KEY.every((r) => has(i, r)));
const byRegions = all
  .slice()
  .sort((a, b) => b.regionCount - a.regionCount || (b.nodeTotal ?? 0) - (a.nodeTotal ?? 0) || a.rank - b.rank)
  .filter((i) => extra(i).length)
  .slice(0, 6);

const title = 'Clash 机场推荐 ' + month + '｜' + n + ' 家支持 Clash 订阅的机场与客户端兼容说明';
const description =
  '本站整理的 ' + n + ' 家机场都提供 Clash 订阅，但节点协议都是 VLESS，必须用 Clash Meta（mihomo）内核的客户端。这里说明哪些 Clash 客户端能用、主推机场的节点地区，以及导入订阅没有节点怎么办。';

const crumbs = [
  { name: '首页', path: '/' },
  { name: PILLAR.label, path: PILLAR.path },
  { name: 'Clash 机场推荐', path: '/clash-jichang/' },
];

const faq = [
  {
    q: 'Clash 导入机场订阅后没有节点，或者提示错误，怎么办？',
    a: '最常见的原因是客户端内核太旧。本站整理的机场节点都是 VLESS 协议，原版 Clash 内核（Clash for Windows、ClashX、Clash for Android 用的就是）不支持 VLESS，导入后节点会缺失或报错。换成 Clash Verge Rev、Clash Meta for Android 这类 mihomo 内核的客户端就能解决。',
  },
  {
    q: 'Clash 和 Clash Meta、mihomo 是什么关系？',
    a: 'Clash 是最早的开源内核，原作者 2023 年停止维护。Clash Meta 是社区在它基础上继续开发的分支，后来改名 mihomo，加入了 VLESS 等新协议。现在说"Clash 客户端"，基本都应该选 mihomo 内核的。',
  },
  {
    q: '有免费的 Clash 机场吗？',
    a: '本站整理的机场都没有免费试用。网上和 GitHub 上分享的免费 Clash 节点大多不稳定、很快失效，而且来源不明，存在隐私风险。想低成本试用，可以先买最便宜的月付套餐。',
  },
  {
    q: 'Clash 规则模式和全局模式选哪个？',
    a: '日常选规则模式：国内网站直连，国外网站走代理，速度快也省流量。只有某个网站在规则模式下打不开时，再临时切到全局模式。',
  },
  {
    q: 'iPhone 能用 Clash 订阅吗？',
    a: 'iPhone 上更常用的是 Shadowrocket（小火箭），同样支持机场的订阅链接和 VLESS 协议，需要外区 Apple ID 购买下载。',
  },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Clash 机场推荐 ' + month,
    numberOfItems: featured.length,
    itemListElement: featured.map((i, k) => ({ '@type': 'ListItem', position: k + 1, name: i.aff.name, url: absoluteUrl(i.path) })),
  },
  faqSchema(faq),
];
---

<Base title={title} description={description} jsonLd={jsonLd} modified={updated}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <header class="head">
      <h1>Clash 机场推荐 {month}</h1>
      <p class="lead">
        "Clash 机场"不是一类特殊的机场，只要提供 Clash 订阅就算。本站整理的 {n} 家都提供，真正要注意的是另一件事：{allVless ? '这 ' + n + ' 家的节点全部是 VLESS 协议' : '其中 ' + vless.length + ' 家的节点是 VLESS 协议'}，老版 Clash 用不了。先选对客户端，再选机场。
      </p>
      <p class="meta">
        最后更新 <time class="num" datetime={updated.toISOString()}>{formatDate(updated)}</time> · 价格和节点来自各机场官网与后台，以官网为准
      </p>
    </header>

    <aside class="alert">
      <p class="t">导入订阅前先确认：你的 Clash 是 mihomo（Clash Meta）内核吗？</p>
      <p>VLESS 只有 mihomo 内核支持。用 Clash for Windows、ClashX、Clash for Android 这类老客户端，导入后会出现节点缺失、报错或连不上。这是 Clash 用户买了机场却用不了的最常见原因。</p>
    </aside>

    <div class="body">
      <section>
        <h2>哪些 Clash 客户端能用</h2>
        <div class="table-scroll">
          <table class="data-table">
            <thead><tr><th>客户端</th><th>系统</th><th>内核</th><th>VLESS</th><th>说明</th></tr></thead>
            <tbody>
              <tr class="ok"><th scope="row"><a href="/jiaocheng/clash-verge-rev-jiaocheng/">Clash Verge Rev</a></th><td>Windows / macOS / Linux</td><td>mihomo</td><td>✅ 支持</td><td>电脑首选，本站有教程</td></tr>
              <tr class="ok"><th scope="row"><a href="/jiaocheng/clash-meta-for-android-jiaocheng/">Clash Meta for Android</a></th><td>安卓</td><td>mihomo</td><td>✅ 支持</td><td>安卓首选，本站有教程</td></tr>
              <tr class="ok"><th scope="row">FlClash</th><td>Windows / macOS / 安卓</td><td>mihomo</td><td>✅ 支持</td><td>界面简洁，多平台通用</td></tr>
              <tr class="ok"><th scope="row">ClashX Meta</th><td>macOS</td><td>mihomo</td><td>✅ 支持</td><td>ClashX 的 Meta 版本</td></tr>
              <tr class="no"><th scope="row">Clash for Windows</th><td>Windows / macOS</td><td>原版 Clash</td><td>❌ 不支持</td><td>已停止更新，不建议再用</td></tr>
              <tr class="no"><th scope="row">ClashX（原版）</th><td>macOS</td><td>原版 Clash</td><td>❌ 不支持</td><td>换成 ClashX Meta 或 Clash Verge Rev</td></tr>
              <tr class="no"><th scope="row">Clash for Android</th><td>安卓</td><td>原版 Clash</td><td>❌ 不支持</td><td>换成 Clash Meta for Android</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          iPhone 上一般不用 Clash，而是用 <a href="/jiaocheng/shadowrocket-jiaocheng/">Shadowrocket（小火箭）</a>，同样能导入机场订阅、支持 VLESS，选机场可以看<a href="/xiaohuojian-jichang/">小火箭机场推荐</a>。不想用 Clash 的 Windows 用户，也可以用 <a href="/jiaocheng/v2rayn-jiaocheng/">v2rayN</a>。
        </p>
      </section>

      {main && (
        <section class="main-box">
          <h2>站长主推：{main.aff.name}</h2>
          <p>
            {main.aff.name}官网标注{main.profile.lineType}，后台 {main.nodeTotal} 个节点，覆盖{(main.profile.regions ?? []).join('、')}。复制订阅链接后，在 Clash Verge Rev 或 Clash Meta for Android 里一键导入就能用。月付 {yuan(main.monthlyFrom ?? 0)} 起{main.monthlyFromGB ? '，每月 ' + gb(main.monthlyFromGB) : ''}{main.aff.coupon ? '；下单填优惠码 ' + main.aff.coupon + '，月付、季付、半年付立减 ' + main.aff.couponOff + '%' : ''}。
          </p>
          <p class="actions">
            <a class="btn" href={main.aff.url} rel="sponsored nofollow noopener" target="_blank">访问 {main.aff.name} 官网</a>
            <a class="btn btn--ghost" href={main.path}>看 {main.aff.name} 全部套餐</a>
          </p>
        </section>
      )}

      <section>
        <h2>Clash 用户推荐的 {featured.length} 家机场</h2>
        <p>
          Clash 的长处是分流：国内直连、国外走代理，还能按网站指定地区，比如 ChatGPT 走美国或日本节点、看港剧走香港节点。所以除了价格，节点覆盖的地区也很重要。下面是本站主推和次推的 {featured.length} 家。
        </p>
        <div class="table-scroll">
          <table class="data-table">
            <thead><tr><th>#</th><th>机场</th><th>节点</th><th>港 / 台 / 日 / 新 / 美</th><th>其他地区</th><th>月付起价</th><th>优惠码</th></tr></thead>
            <tbody>
              {featured.map((i) => (
                <tr class={i.rank === 1 ? 'is-main' : ''}>
                  <td class="num">{i.rank}</td>
                  <th scope="row"><a href={i.path}>{i.aff.name}</a></th>
                  <td class="nowrap">{i.nodeTotal ? i.nodeTotal + ' 个' : '—'}</td>
                  <td class="nowrap regions">{KEY.map((r) => <span class={has(i, r) ? 'y' : 'n'} title={r}>{r.slice(0, 1)}</span>)}</td>
                  <td>{extra(i).length ? extra(i).join('、') : '—'}</td>
                  <td class="num nowrap">{i.monthlyFrom !== null ? yuan(i.monthlyFrom) + '/月' : '—'}</td>
                  <td class="nowrap">{i.aff.couponOff ? '立减 ' + i.aff.couponOff + '%' : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="meta">
          {n} 家里有 {fullFive.length} 家同时有香港、台湾、日本、新加坡、美国节点，日常分流基本够用。其余机场见<a href={PILLAR.path}>完整推荐榜</a>。
        </p>
      </section>

      {!!byRegions.length && (
        <section>
          <h2>想多几个地区分流，看这几家</h2>
          <p>如果你需要英国、德国、马来西亚等地区的节点（比如看当地的流媒体、用当地服务），下面这几家后台列出的地区最多。</p>
          <ol class="deal">
            {byRegions.map((i) => (
              <li class={i.rank === 1 ? 'is-main' : ''}>
                <a href={i.path}>{i.aff.name}</a>
                <span>{i.regionCount} 个地区：除常用 5 个外还有{extra(i).join('、')}</span>
                <strong class="num">{i.nodeTotal} 个节点</strong>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section class="prose">
        <h2>机场订阅导入 Clash，三步</h2>
        <ol>
          <li><strong>复制订阅链接</strong>：登录机场官网，在仪表盘或"我的订阅"里找到"一键订阅"，选 Clash 或"复制订阅地址"。</li>
          <li><strong>导入客户端</strong>：打开 Clash Verge Rev 的"订阅"页（安卓是"配置"），粘贴链接，点导入。</li>
          <li><strong>选节点、开代理</strong>：在"代理"页选一个节点，打开系统代理（安卓点启动），就可以用了。</li>
        </ol>
        <p>
          每一步的截图和细节设置，见 <a href="/jiaocheng/clash-verge-rev-jiaocheng/">Clash Verge Rev 教程</a> 和 <a href="/jiaocheng/clash-meta-for-android-jiaocheng/">Clash Meta for Android 教程</a>。
        </p>
        <h3>订阅链接等于账号</h3>
        <p>别人拿到你的订阅链接就能直接用你的流量。不要发到群里或截图外传，泄露了可以在机场后台"重置订阅"。</p>
        <h3>"Clash 免费机场""GitHub 免费节点"能用吗</h3>
        <p>能连上的往往撑不了几天，速度也没保障；更大的问题是不知道是谁在运营，流量经过别人的服务器，账号密码有被记录的风险。真想省钱，买一个 ¥15 到 ¥25 的月付套餐，比折腾免费节点省心得多，<a href="/pianyi-jichang/">便宜机场推荐</a>里有完整价格排名。</p>
      </section>

      <TelegramCta />

      <section class="prose">
        <h2>相关页面</h2>
        <ul>
          <li><a href={PILLAR.path}>机场推荐 {month}：{n} 家机场完整对比</a></li>
          <li><a href="/jichang-youhuima/">机场优惠码汇总</a></li>
          <li><a href="/zhuanxian-jichang/">IPLC / IEPL 专线机场</a></li>
          <li><a href="/wenzhang/jichang-xianlu-qubie/">机场线路怎么选：直连、中转、BGP、专线</a></li>
        </ul>
      </section>

      <Faq items={faq} />
      <p class="meta small">页面里的官网链接是推广链接，通过它注册价格不变，本站可能获得佣金。</p>
    </div>
  </div>
</Base>

<style>
  .head {
    max-width: 48rem;
    margin-bottom: 1.25rem;
  }

  .lead {
    color: var(--ink-soft);
  }

  .alert {
    max-width: 52rem;
    padding: 0.9rem 1.1rem;
    background: var(--slate);
    color: #e6eaee;
    border-radius: var(--radius-md);
  }

  .alert p {
    margin: 0;
  }

  .alert .t {
    color: var(--sign);
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .body {
    max-width: 52rem;
    margin-top: 2rem;
  }

  .body > section > h2,
  .body .prose h2 {
    border-top: 2px solid var(--ink);
    padding-top: 0.25em;
  }

  .data-table tbody th {
    background: var(--surface);
    color: var(--ink);
    white-space: nowrap;
  }

  tr.no td,
  tr.no th {
    color: var(--muted);
  }

  tr.is-main td,
  tr.is-main th {
    background: #fffbea !important;
  }

  .nowrap {
    white-space: nowrap;
  }

  .regions span {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 2px;
    border-radius: 3px;
    font-size: 0.8125rem;
  }

  .regions .y {
    background: var(--ink);
    color: var(--sign);
  }

  .regions .n {
    background: #eef1f4;
    color: #b6bec7;
    text-decoration: line-through;
  }

  .deal {
    padding-left: 1.4em;
  }

  .deal li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    align-items: baseline;
    padding: 0.25rem 0;
  }

  .deal li a {
    font-weight: 700;
  }

  .deal li span {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .deal li strong {
    margin-left: auto;
  }

  .main-box {
    margin: 2rem 0 0;
    padding: 0.25rem 1.25rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--sign);
    border-radius: var(--radius-sm);
  }

  .main-box h2 {
    border-top: 0 !important;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
