---
// 登机牌：评测文章顶部的机场信息卡
import type { Airport } from '../lib/content';
import { formatDate, formatPrice } from '../lib/format';

interface Props {
  airport: Airport;
}
const d = Astro.props.airport.data;
const unlock = [
  ['Netflix', d.unlock.netflix],
  ['Disney+', d.unlock.disney],
  ['ChatGPT', d.unlock.chatgpt],
] as const;
---

<aside class="pass" aria-label={`${d.name} 基本信息`}>
  <div class="main">
    <p class="label">机场</p>
    <p class="name">{d.name}</p>
    <dl class="fields">
      <div><dt>起价</dt><dd class="num big">{formatPrice(d.priceFrom)}<small>/月{d.priceNote ? `（${d.priceNote}）` : ''}</small></dd></div>
      <div><dt>线路</dt><dd>{d.lineType}</dd></div>
      <div><dt>协议</dt><dd>{d.protocols.join(' / ')}</dd></div>
      <div><dt>节点</dt><dd><span class="num">{d.nodeCount}</span> 个</dd></div>
      <div class="wide"><dt>地区</dt><dd>{d.regions.join('、')}</dd></div>
      <div class="wide">
        <dt>解锁</dt>
        <dd>
          {unlock.map(([n, ok]) => <span class:list={['chip', { off: !ok }]}>{n}{ok ? ' ✓' : ' ✗'}</span>)}
        </dd>
      </div>
      <div><dt>试用</dt><dd>{d.trial ? '有' : '无'}</dd></div>
      <div><dt>状态</dt><dd><span class={`status status--${d.status}`}>{d.status}</span></dd></div>
    </dl>
  </div>
  <div class="stub">
    <p class="label">综合评分</p>
    <p class="score num">{d.score.toFixed(1)}<small>/10</small></p>
    <p class="tested">实测于 <span class="num">{formatDate(d.testedAt)}</span></p>
    <a class="btn" href={d.url} rel="sponsored nofollow noopener" target="_blank">访问 {d.name} 官网</a>
  </div>
</aside>

<style>
  .pass {
    display: grid;
    grid-template-columns: 1fr 13rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    margin: 0 0 2.5rem;
    overflow: hidden;
  }

  .main {
    padding: 1.25rem 1.5rem;
  }

  .stub {
    position: relative;
    padding: 1.25rem 1.25rem;
    background: var(--slate);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* 撕线 */
  .stub::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.75rem;
    bottom: 0.75rem;
    border-left: 2px dashed #8492a0;
  }

  .label {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .stub .label {
    color: #9aa6b2;
  }

  .name {
    margin: 0 0 0.75rem;
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.3;
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    margin: 0;
  }

  .fields .wide {
    grid-column: span 2;
  }

  dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-weight: 600;
    line-height: 1.5;
  }

  .big {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  dd small {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
  }

  .chip {
    display: inline-block;
    font-size: 0.8125rem;
    padding: 0 0.4em;
    margin: 0 0.3em 0.3em 0;
    border-radius: 3px;
    background: #e3f4ea;
    color: #136b3a;
  }

  .chip.off {
    background: #eef0f2;
    color: var(--muted);
    text-decoration: line-through;
  }

  .score {
    margin: 0;
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--sign);
  }

  .score small {
    font-size: 1.25rem;
    color: #9aa6b2;
  }

  .tested {
    font-size: 0.8125rem;
    color: #9aa6b2;
    margin: 0.5rem 0 1rem;
  }

  .btn {
    text-align: center;
  }

  @media (max-width: 760px) {
    .pass {
      grid-template-columns: 1fr;
    }
    .fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stub::before {
      left: 0.75rem;
      right: 0.75rem;
      top: -1px;
      bottom: auto;
      border-left: 0;
      border-top: 2px dashed #8492a0;
    }
  }
</style>
