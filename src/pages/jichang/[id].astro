---
// 单家机场资料页：全部内容来自官网资料整理，不含任何未经实测的速度或评分
import Base from '../../layouts/Base.astro';
import TelegramCta from '../../components/TelegramCta.astro';
import TestResult from '../../components/TestResult.astro';
import AuditCard from '../../components/AuditCard.astro';
import TopologyNote from '../../components/TopologyNote.astro';
import { auditOf } from '../../lib/audit';
import { pairsOf } from '../../lib/duibi';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { formatDate } from '../../lib/format';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import {
  PLAN_TYPE_LABEL,
  getAff,
  lowestMonthly,
  lowestMonthlyPlan,
  perGB,
  perMonth,
  profilePath,
  profiles,
  yuan,
  gb,
  type Plan,
  type Profile,
  zhe,
} from '../../lib/profiles';

export function getStaticPaths() {
  return profiles.map((p) => ({ params: { id: p.id }, props: { profile: p } }));
}

interface Props {
  profile: Profile;
}

const { profile: pr } = Astro.props;
const aff = getAff(pr.id)!;
const name = aff.name;
const vs = pairsOf(pr.id);
const collected = new Date(pr.collectedAt);
const year = collected.getFullYear();

const cheapest = lowestMonthly(pr);
const cheapestMonthly = lowestMonthlyPlan(pr);
const standard = pr.plans.filter((p) => !p.custom);
const customPlans = pr.plans.filter((p) => p.custom);
const groups = (['monthly', 'quarterly', 'semiannual', 'yearly', 'onetime'] as Plan['type'][])
  .map((t) => ({ type: t, plans: standard.filter((p) => p.type === t) }))
  .filter((g) => g.plans.length);
const onetime = standard.filter((p) => p.type === 'onetime');
const periodic = standard.filter((p) => p.type !== 'onetime');
const gbRange = (list: Plan[], digits = 2) => {
  const v = list.map(perGB);
  const lo = yuan(Math.min(...v), digits);
  const hi = yuan(Math.max(...v), digits);
  return lo === hi ? lo : `${lo}–${hi}`;
};

const nearRegions = (pr.regions ?? []).filter((r) => ['香港', '台湾', '日本', '新加坡', '韩国'].includes(r));
const hasHK = (pr.regions ?? []).includes('香港');
const title = `${name}机场怎么样？套餐价格、线路与优惠码整理（${year}）`;
const nodeN = pr.nodeCount?.match(/\d+/)?.[0];
const description =
  name + '机场怎么样？' +
  (pr.lineType ? '官方标注' + pr.lineType + '，' : '') +
  (nodeN ? '后台 ' + nodeN + ' 个节点' + (pr.regions?.length ? '，覆盖' + pr.regions.join('、') : '') + '，' : '') +
  (cheapest ? '套餐最低折合 ' + yuan(cheapest.value) + '/月，' : '') +
  '设备数' + (pr.devices ?? '以官网为准') + '。' +
  (pr.tests?.length ? '附站长实测速度和流媒体解锁结果，' : '') +
  (aff.coupon && aff.couponOff ? '优惠码 ' + aff.coupon + ' 立减 ' + aff.couponOff + '%，' : '') +
  '整理全部套餐价格、每 GB 单价和选购建议。';

const crumbs = [
  { name: '首页', path: '/' },
  { name: '机场官网导航', path: '/jichang-daohang/' },
  { name: name, path: profilePath(pr.id) },
];

const faq = [
  ...(cheapest
    ? [
        {
          q: `${name}最便宜的套餐多少钱？`,
          a: `按 ${pr.collectedAt} 整理的官网价格，折合每月最便宜的是「${cheapest.plan.name}」，${PLAN_TYPE_LABEL[cheapest.plan.type]} ${yuan(cheapest.plan.price)}，折合约 ${yuan(cheapest.value)}/月。${cheapestMonthly ? `如果只想买一个月试试，最便宜的月付套餐是「${cheapestMonthly.name}」，${yuan(cheapestMonthly.price)}/月。` : ''}价格可能调整，以官网为准。`,
        },
      ]
    : []),
  ...(pr.devices ? [{ q: `${name}有设备数量限制吗？`, a: `根据官网套餐说明，${name}的设备数${pr.devices}。` }] : []),
  ...(onetime.length
    ? [
        {
          q: `${name}的不限时套餐流量会过期吗？`,
          a: `官网说明不限时套餐是一次性购买的总流量，没有时间限制。适合用量不固定、偶尔才用的人，但每 GB 的价格比月付和年付套餐高不少。`,
        },
      ]
    : []),
  ...(aff.coupon
    ? [
        {
          q: `${name}有优惠码吗？`,
          a: '有，下单时填写优惠码「' + aff.coupon + '」' + (aff.couponOff ? '，立减 ' + aff.couponOff + '%（相当于 ' + zhe(aff.couponOff) + '）' : '') + '，可用于月付、季付和半年付，年付一般不能用。一切以官网和结算页面为准。更多机场的优惠码见本站的机场优惠码汇总。',
        },
      ]
    : []),
];

// 各客户端对协议的支持（依据各应用官方说明整理，见 iOS 客户端对比一文）
const CLIENTS: { name: string; href?: string; supports: string[] }[] = [
  { name: 'Clash Verge Rev（Windows / macOS）', href: '/jiaocheng/clash-verge-rev-jiaocheng/', supports: ['VLESS', 'VMESS', 'TROJAN', 'SHADOWSOCKS', 'HYSTERIA2', 'TUIC'] },
  { name: 'v2rayN（Windows）', href: '/jiaocheng/v2rayn-jiaocheng/', supports: ['VLESS', 'VMESS', 'TROJAN', 'SHADOWSOCKS', 'HYSTERIA2', 'TUIC'] },
  { name: 'Clash Meta for Android', href: '/jiaocheng/clash-meta-for-android-jiaocheng/', supports: ['VLESS', 'VMESS', 'TROJAN', 'SHADOWSOCKS', 'HYSTERIA2', 'TUIC'] },
  { name: 'Shadowrocket（iPhone）', href: '/jiaocheng/shadowrocket-jiaocheng/', supports: ['VLESS', 'VMESS', 'TROJAN', 'SHADOWSOCKS', 'HYSTERIA2', 'TUIC'] },
  { name: 'Stash（iPhone）', supports: ['VLESS', 'VMESS', 'TROJAN', 'SHADOWSOCKS', 'HYSTERIA2', 'TUIC'] },
  { name: 'Loon（iPhone）', supports: ['VLESS', 'VMESS', 'TROJAN', 'SHADOWSOCKS', 'HYSTERIA2'] },
  { name: 'Quantumult X（iPhone）', supports: ['VLESS', 'VMESS', 'TROJAN', 'SHADOWSOCKS'] },
  { name: 'Surge（iPhone）', supports: ['VMESS', 'TROJAN', 'SHADOWSOCKS', 'HYSTERIA2', 'TUIC'] },
];
const protoKeys = (pr.protocols ?? []).map((p) => p.toUpperCase().replace(/\s+/g, ''));
const clientRows = CLIENTS.map((c) => ({ ...c, ok: protoKeys.length > 0 && protoKeys.every((k) => c.supports.includes(k)) }));
const unsupported = clientRows.filter((c) => !c.ok).map((c) => c.name.replace(/（.*）/, ''));

if (pr.protocols) faq.push({ q: `${name}用什么协议？哪些客户端能用？`, a: `${name}使用 ${pr.protocols.join('、')} 协议。Clash Verge Rev、v2rayN、Clash Meta for Android、Shadowrocket 等常用客户端都支持${unsupported.length ? `；${unsupported.join('、')}不支持，用不了` : ''}。` });
if (pr.trial) faq.push({ q: `${name}有免费试用吗？`, a: `${pr.trial}。第一次购买建议先选最便宜的月付套餐，确认好用再买长期套餐。` });
if (pr.refund) faq.push({ q: `${name}可以退款吗？`, a: `${pr.refund}。购买前最好先看清套餐说明。` });

const jsonLd = [breadcrumbSchema(crumbs), faqSchema(faq)];
---

<Base title={title} description={description} jsonLd={jsonLd} type="article" modified={collected}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <article class="article">
      <header class="head">
        <h1>{title}</h1>
        <p class="meta source">
          <span>资料来源：{name}官网</span>
          <span>整理于 <time class="num" datetime={collected.toISOString()}>{formatDate(collected)}</time></span>
          <span>价格以官网为准</span>
        </p>
      </header>

      <section class="facts" aria-label={`${name}基本资料`}>
        <dl>
          {cheapest && (
            <div>
              <dt>最低折合月价</dt>
              <dd class="num big">{yuan(cheapest.value)}<small>/月</small></dd>
              <dd class="sub">{cheapest.plan.name}</dd>
            </div>
          )}
          {cheapestMonthly && (
            <div>
              <dt>月付起价</dt>
              <dd class="num big">{yuan(cheapestMonthly.price)}<small>/月</small></dd>
              <dd class="sub">{cheapestMonthly.name}</dd>
            </div>
          )}
          <div>
            <dt>套餐类型</dt>
            <dd>{groups.map((g) => PLAN_TYPE_LABEL[g.type]).join(' / ')}</dd>
          </div>
          {pr.lineType && (
            <div>
              <dt>官方标注线路</dt>
              <dd>{pr.lineType}</dd>
            </div>
          )}
          {pr.regions && (
            <div>
              <dt>节点地区</dt>
              <dd>{pr.regions.join('、')}</dd>
            </div>
          )}
          {pr.nodeCount && (
            <div>
              <dt>节点数量</dt>
              <dd>{pr.nodeCount}</dd>
            </div>
          )}
          {pr.protocols && (
            <div>
              <dt>协议</dt>
              <dd>{pr.protocols.join(' / ')}</dd>
            </div>
          )}
          {pr.trial && (
            <div>
              <dt>免费试用</dt>
              <dd>{pr.trial}</dd>
            </div>
          )}
          {pr.devices && (
            <div>
              <dt>设备数</dt>
              <dd>{pr.devices}</dd>
            </div>
          )}
          {pr.rate && (
            <div>
              <dt>流量倍率</dt>
              <dd>{pr.rate}</dd>
            </div>
          )}
          {aff.coupon && (
            <div>
              <dt>优惠码</dt>
              <dd><code>{aff.coupon}</code>{aff.couponOff ? ' 立减 ' + aff.couponOff + '%' : ''}</dd>
            </div>
          )}
        </dl>
        <a class="btn" href={aff.url} rel="sponsored nofollow noopener" target="_blank">访问 {name} 官网</a>
      </section>

      <div class="prose">
        <h2>{name}套餐价格一览</h2>
        <p>下面是{name}官网目前在售的全部套餐。"每 GB 单价"是本站按价格和流量换算的，方便横向比较。</p>
        {
          groups.map((g) => (
            <>
              <h3>{PLAN_TYPE_LABEL[g.type]}套餐</h3>
              <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>套餐</th>
                    <th>价格</th>
                    <th>流量</th>
                    {g.type !== 'onetime' && g.type !== 'monthly' && <th>折合每月</th>}
                    <th>每 GB 单价</th>
                  </tr>
                </thead>
                <tbody>
                  {g.plans.map((p) => (
                    <tr>
                      <td>
                        {p.name}
                        {p.note && <small class="pnote">{p.note}</small>}
                      </td>
                      <td class="num">{`${yuan(p.price)}${g.type === 'onetime' ? ' 一次性' : `/${g.type === 'yearly' ? '年' : g.type === 'quarterly' ? '季' : g.type === 'semiannual' ? '半年' : '月'}`}`}</td>
                      <td>{p.trafficPer === 'month' ? `每月 ${gb(p.trafficGB)}` : `${gb(p.trafficGB)}（总量）`}</td>
                      {g.type !== 'onetime' && g.type !== 'monthly' && <td class="num">{yuan(perMonth(p)!)}</td>}
                      <td class="num">{yuan(perGB(p), 3)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              </div>
              {g.type === 'monthly' && pr.discounts && <p class="discount">{pr.discounts}。</p>}
            </>
          ))
        }

        {
          customPlans.length > 0 && (
            <>
              <h3>定制套餐</h3>
              <p>面向有特殊需求的用户，不参与上面的价格对比：</p>
              <ul>
                {customPlans.map((p) => (
                  <li>
                    <strong>{p.name}</strong>：{yuan(p.price)}/月起，{p.trafficGB ? `每月 ${gb(p.trafficGB)}` : '流量按需定制'}。{p.note}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {pr.tests && pr.tests[0] && <TestResult name={name} test={pr.tests[0]} />}
        {aff && <AuditCard name={name} audit={auditOf(pr, aff)} tested={!!pr.tests?.length} />}
        {pr.topology && <TopologyNote name={name} topo={pr.topology} />}

        {
          pr.regions && (
            <>
              <h2>{name}节点分布</h2>
              <p>
                根据{name}后台的节点列表，目前提供 {pr.regions.join('、')} 共 {pr.regions.length} 个地区的节点{pr.nodeCount && `，合计${pr.nodeCount}`}。
                {pr.nodeNote && `${pr.nodeNote}。`}
              </p>
              {pr.lineNote && <p>{pr.lineNote}。</p>}
              {pr.groups && (
                <p>
                  订阅里自带「{pr.groups.join('」「')}」等策略分组。新手直接用"自动选择"即可，客户端会自动挑延迟最低的节点。
                </p>
              )}
              <p>
                {nearRegions.length > 0 && `${nearRegions.join('、')}离国内近，适合日常使用。`}
                {hasHK && (
                  <>
                    需要用 ChatGPT 时注意不要选香港节点，原因见 <a href="/jiaocheng/chatgpt-da-bu-kai/">ChatGPT 打不开怎么办</a>。
                  </>
                )}
              </p>
            </>
          )
        }

        {
          pr.protocols && (
            <>
              <h2>{name}用什么协议？哪些客户端能用</h2>
              <p>
                {name}的节点使用 <strong>{pr.protocols.join('、')}</strong> 协议。买之前先确认你的客户端支持它，否则导入订阅也连不上：
              </p>
              <div class="table-scroll">
              <table>
                <thead>
                  <tr><th>客户端</th><th>能否使用</th></tr>
                </thead>
                <tbody>
                  {clientRows.map((c) => (
                    <tr>
                      <td>{c.href ? <a href={c.href}>{c.name}</a> : c.name}</td>
                      <td>{c.ok ? '✓ 可以' : '✗ 不支持'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              </div>
              <p>
                客户端支持情况依据各应用的官方说明整理，iPhone 客户端的详细对比见 <a href="/jiaocheng/ios-kehuduan-duibi/">iOS 代理客户端怎么选</a>。
              </p>
            </>
          )
        }

        {
          (pr.trial || pr.refund) && (
            <>
              <h2>试用与退款</h2>
              <ul>
                {pr.trial && <li><strong>免费试用：</strong>{pr.trial}。想先体验的话，可以买最便宜的月付套餐。</li>}
                {pr.refund && <li><strong>退款：</strong>{pr.refund}。</li>}
              </ul>
            </>
          )
        }

        <h2>{name}官方介绍的特点</h2>
        <p>以下是{name}官网对套餐的介绍：</p>
        <ul>{pr.claims.map((c) => <li>{c}</li>)}</ul>
        <p>
          其中"专线"是机场价格差异最大的因素。专线、中转和直连分别是什么意思，可以看<a href="/wenzhang/jichang-shi-shenme/">机场是什么</a>。
          {pr.unlock?.includes('ChatGPT') && (
            <>
              官方说明支持 ChatGPT，购买后可以用<a href="/jiaocheng/chatgpt-da-bu-kai/">这篇教程里的方法</a>自己验证节点能否使用。
            </>
          )}
        </p>

        <h2>{name}套餐怎么选</h2>
        <ul>
          {cheapestMonthly && (
            <li>
              <strong>第一次买，想先试试：</strong>选最便宜的月付「{cheapestMonthly.name}」（{yuan(cheapestMonthly.price)}/月），用一两周确认晚高峰速度和常用网站都正常，再考虑长期套餐。
            </li>
          )}
          {cheapest && cheapest.plan.type !== 'monthly' && (
            <li>
              <strong>确定长期使用、追求最低价：</strong>「{cheapest.plan.name}」折合约 {yuan(cheapest.value)}/月，是整体最便宜的选择。但长周期套餐要一次付清，机场行业有跑路风险，建议先用过月付再决定。
            </li>
          )}
          {onetime.length > 0 && periodic.length > 0 && (
            <li>
              <strong>用量不固定、偶尔才用：</strong>可以考虑不限时套餐，流量用多少扣多少、不过期。代价是单价更高：不限时套餐每 GB 约 {gbRange(onetime)}，周期套餐只要约 {gbRange(periodic, 3)}。
            </li>
          )}
          <li>
            <strong>估算自己的用量：</strong>日常刷网页、聊天一个月通常几 GB 到十几 GB；经常看 1080p 视频要几十 GB；常看 4K 流媒体可能要 100GB 以上。
          </li>
        </ul>

        {
          pr.pending && pr.pending.length > 0 && (
            <>
              <h2>还在整理中的资料</h2>
              <p>以下信息本站还没有整理完成，购买前可以在官网或客服处确认：{pr.pending.join('、')}。</p>
            </>
          )
        }

        <h2>购买后怎么用</h2>
        <p>
          买好套餐后，在{name}后台复制订阅链接，导入客户端即可：电脑用 <a href="/jiaocheng/clash-verge-rev-jiaocheng/">Clash Verge Rev</a> 或 <a href="/jiaocheng/v2rayn-jiaocheng/">v2rayN</a>，iPhone 用 <a href="/jiaocheng/shadowrocket-jiaocheng/">Shadowrocket</a>，安卓用 <a href="/jiaocheng/clash-meta-for-android-jiaocheng/">Clash Meta for Android</a>。
        </p>
      </div>

      <p class="cta">
        <a class="btn" href={aff.url} rel="sponsored nofollow noopener" target="_blank">访问 {name} 官网</a>
        {aff.coupon && <span>下单时填写优惠码 <code>{aff.coupon}</code>{aff.couponOff ? '，立减 ' + aff.couponOff + '%' : ''} · <a href="/jichang-youhuima/">全部优惠码</a></span>}
      </p>

      {!!vs.length && (
        <section class="vs-links">
          <h2>{name}和其他机场对比</h2>
          <ul>
            {vs.map((p) => <li><a href={'/duibi/' + p.slug + '/'}>{p.A.aff.name} vs {p.B.aff.name}</a></li>)}
          </ul>
        </section>
      )}

      <TelegramCta />
        <Faq items={faq} />

      <p class="more">想看更多机场，可以去<a href="/jichang-daohang/">机场官网导航</a>。</p>
    </article>
  </div>
</Base>

<style>
  .vs-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    padding: 0;
    list-style: none;
  }

  .article {
    max-width: var(--measure);
  }

  .head {
    margin-bottom: 1.25rem;
  }

  .head .meta {
    margin: 0;
  }

  .source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .facts {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem;
    margin-bottom: 2rem;
  }

  .facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.9rem 1.25rem;
    margin: 0 0 1rem;
  }

  .facts dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 600;
    line-height: 1.5;
  }

  .facts .big {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .facts .big small {
    font-size: 0.8125rem;
    font-family: var(--font-body);
    color: var(--muted);
    font-weight: 400;
  }

  .facts .sub {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--muted);
  }

  .facts code,
  .cta code {
    font-family: var(--font-mono);
    background: #eef1f4;
    padding: 0 0.35em;
    border-radius: 3px;
  }

  .discount {
    margin-top: -0.5em;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  td.num {
    white-space: nowrap;
  }

  .pnote {
    display: block;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 2.5rem 0 0;
    padding: 1rem 1.2rem;
    background: var(--surface);
    border-left: 4px solid var(--sign);
  }

  .more {
    margin-top: 2rem;
  }
</style>
