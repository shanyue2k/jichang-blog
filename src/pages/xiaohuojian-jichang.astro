---
// 专题：小火箭机场推荐（长尾词：小火箭机场推荐 / 小火箭机场节点推荐 / 小火箭机场稳定推荐购买 / 机场推荐 shadowrocket / 小火箭机场免费试用）
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import TelegramCta from '../components/TelegramCta.astro';
import { PILLAR } from '../site.config';
import { absoluteUrl } from '../lib/content';
import { formatDate } from '../lib/format';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { FEATURED_COUNT, cheapestForUsage, getRanking, monthLabel, rankingUpdated, type PlanPick } from '../lib/ranking';
import { PLAN_TYPE_LABEL, gb, yuan } from '../lib/profiles';

const all = getRanking();
const updated = rankingUpdated(all);
const month = monthLabel(updated);
const n = all.length;
const featured = all.slice(0, FEATURED_COUNT);
const main = all[0];
const vless = all.filter((i) => (i.profile.protocols ?? []).includes('VLESS')).length;
const unlimited = all.filter((i) => (i.profile.devices ?? '').startsWith('不限')).length;

// 手机用量：只用手机的人流量一般不大
const phone = [
  { need: 30, who: '只在手机上刷社交、查资料' },
  { need: 100, who: '手机常看 YouTube、短视频' },
  { need: 200, who: '手机 + 平板 + 电脑一起用' },
].map((u) => ({ ...u, list: cheapestForUsage(all, u.need).slice(0, 4) }));

const smallestMonthly = (i: (typeof all)[number]) =>
  i.profile.plans.filter((p) => p.type === 'monthly' && !p.custom).sort((a, b) => a.price - b.price)[0];

const pay = (p: PlanPick) => (p.months === 1 ? yuan(p.plan.price) + '/月' : yuan(p.plan.price) + '/' + PLAN_TYPE_LABEL[p.plan.type].replace('付', ''));

const title = '小火箭机场推荐 ' + month + '｜Shadowrocket 能用的 ' + n + ' 家机场与 iPhone 选购建议';
const description =
  '本站整理的 ' + n + ' 家机场订阅都能直接导入小火箭（Shadowrocket）。这里按 iPhone 用户的习惯整理：手机用量该买多大的套餐、设备数限制、主推机场节点，以及下载小火箭需要准备什么。';

const crumbs = [
  { name: '首页', path: '/' },
  { name: PILLAR.label, path: PILLAR.path },
  { name: '小火箭机场推荐', path: '/xiaohuojian-jichang/' },
];

const p30 = phone[0].list[0];
const faq = [
  {
    q: '小火箭能用哪些机场？',
    a: '只要机场提供订阅链接，小火箭基本都能用。本站整理的 ' + n + ' 家机场节点都是 VLESS 协议，小火箭原生支持，复制订阅链接导入就行。',
  },
  {
    q: '有免费试用的小火箭机场吗？',
    a: '本站整理的机场都没有免费试用。网上的"小火箭免费订阅""免费节点"大多几天就失效，来源也不明。想低成本试试，可以先买最便宜的月付套餐，¥15 左右就能用一个月。',
  },
  {
    q: '只在手机上用，买多大流量够？',
    a: p30 ? '只刷社交、查资料，每月 30GB 左右通常够用，最省的是' + p30.item.aff.name + '的「' + p30.plan.name + '」，平均每月 ' + yuan(p30.perMonth) + '。经常在手机上看视频，建议 100GB 以上。' : '一般每月 30GB 到 100GB。',
  },
  {
    q: '小火箭要多少钱？去哪里下载？',
    a: 'Shadowrocket 只在海外区 App Store 上架，美区售价 2.99 美元，一次买断。需要一个外区 Apple ID，本站有注册教程。不要用网上共享的 Apple ID，有被锁机的风险。',
  },
  {
    q: '一个机场账号能同时在 iPhone、iPad、电脑上用吗？',
    a: '本站整理的机场里有 ' + unlimited + ' 家写明不限制设备数量，同一个订阅可以在多台设备上用，但流量是共享的。少数一次性流量包限制设备数，购买前看清楚套餐说明。',
  },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '小火箭机场推荐 ' + month,
    numberOfItems: featured.length,
    itemListElement: featured.map((i, k) => ({ '@type': 'ListItem', position: k + 1, name: i.aff.name, url: absoluteUrl(i.path) })),
  },
  faqSchema(faq),
];
---

<Base title={title} description={description} jsonLd={jsonLd} modified={updated}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <header class="head">
      <h1>小火箭机场推荐 {month}</h1>
      <p class="lead">
        iPhone 上翻墙，多数人用的是小火箭（Shadowrocket）。好消息是：本站整理的 {n} 家机场，订阅链接都能直接导入小火箭，{vless} 家用的 VLESS 协议小火箭也原生支持，不存在"买了用不了"的问题。所以这一页不比兼容性，比的是 iPhone 用户真正在意的：手机用多少流量、能不能多设备一起用、怎么买最省。
      </p>
      <p class="meta">
        最后更新 <time class="num" datetime={updated.toISOString()}>{formatDate(updated)}</time> · 价格和节点来自各机场官网与后台，以官网为准
      </p>
    </header>

    <ol class="prep" aria-label="用小火箭之前要准备的三样东西">
      <li>
        <strong>外区 Apple ID</strong>
        <span>小火箭不在国区 App Store 上架</span>
        <a href="/jiaocheng/waiqu-apple-id-zhuce/">注册教程 →</a>
      </li>
      <li>
        <strong>小火箭 App</strong>
        <span>美区 2.99 美元，一次买断</span>
        <a href="/jiaocheng/shadowrocket-jiaocheng/">下载和设置 →</a>
      </li>
      <li>
        <strong>一个机场订阅</strong>
        <span>下面这些都能用</span>
        <a href="#list">看推荐 →</a>
      </li>
    </ol>

    <div class="body">
      {main && (
        <section class="main-box">
          <h2>站长主推：{main.aff.name}</h2>
          <p>
            {main.aff.name}官网标注{main.profile.lineType}，后台 {main.nodeTotal} 个节点，设备数{(main.profile.devices ?? '').replace('不限制设备数量', '不限制').replace('设备', '')}，手机、平板、电脑可以一起用。复制订阅链接导入小火箭就能用。月付 {yuan(main.monthlyFrom ?? 0)} 起{main.monthlyFromGB ? '，每月 ' + gb(main.monthlyFromGB) : ''}{main.aff.coupon ? '；下单填优惠码 ' + main.aff.coupon + '，月付、季付、半年付立减 ' + main.aff.couponOff + '%' : ''}。
          </p>
          <p class="actions">
            <a class="btn" href={main.aff.url} rel="sponsored nofollow noopener" target="_blank">访问 {main.aff.name} 官网</a>
            <a class="btn btn--ghost" href={main.path}>看 {main.aff.name} 全部套餐</a>
          </p>
        </section>
      )}

      <section>
        <h2>只用手机，买多大的套餐</h2>
        <p>
          手机上的流量比电脑少得多：屏幕小、视频默认清晰度低，很多人一个月几十 GB 就够。买大套餐反而浪费。下面按三种常见用法，挑出流量够用、平均每月最便宜的套餐。
        </p>
        {phone.map((u) => (
          <div class="usage">
            <h3>每月 {u.need}GB 左右：{u.who}</h3>
            <ol>
              {u.list.map((p) => (
                <li class={p.item.rank === 1 ? 'is-main' : ''}>
                  <a href={p.item.path}>{p.item.aff.name}</a>
                  <span>「{p.plan.name}」{pay(p)}，每月 {gb(p.plan.trafficGB)}</span>
                  <strong class="num">{yuan(p.perMonth)}/月</strong>
                </li>
              ))}
            </ol>
          </div>
        ))}
        <p class="meta">"每月"是把季付、半年付、年付平均到每月的价格；年付一般不能用优惠码，详见<a href="/jichang-youhuima/">机场优惠码汇总</a>。</p>
      </section>

      <section id="list">
        <h2>iPhone 用户推荐的 {featured.length} 家机场</h2>
        <p>按本站推荐顺序。"最小月付"是该机场最便宜的月付套餐，第一次买可以从这一档开始试。</p>
        <div class="table-scroll">
          <table class="data-table">
            <thead><tr><th>#</th><th>机场</th><th>最小月付</th><th>节点</th><th>设备数</th><th>优惠码</th></tr></thead>
            <tbody>
              {featured.map((i) => {
                const m = smallestMonthly(i);
                return (
                  <tr class={i.rank === 1 ? 'is-main' : ''}>
                    <td class="num">{i.rank}</td>
                    <th scope="row"><a href={i.path}>{i.aff.name}</a></th>
                    <td class="num nowrap">{m ? yuan(m.price) + ' · ' + gb(m.trafficGB) : '—'}</td>
                    <td class="nowrap">{i.nodeTotal ? i.nodeTotal + ' 个' : '—'}</td>
                    <td>{(i.profile.devices ?? '—').replace('（流量包有设备数限制，见套餐备注）', '')}</td>
                    <td class="nowrap">{i.aff.coupon ? <code>{i.aff.coupon}</code> : '—'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="meta">其余 {n - featured.length} 家同样支持小火箭，见<a href={PILLAR.path}>完整推荐榜</a>。</p>
      </section>

      <section class="prose">
        <h2>订阅导入小火箭，最快的方法</h2>
        <ol>
          <li><strong>在手机上登录机场官网</strong>（用 Safari 打开），进入仪表盘。</li>
          <li><strong>点"一键订阅" → 选 Shadowrocket</strong>。多数机场会直接唤起小火箭，弹出添加订阅的确认框。</li>
          <li><strong>回到小火箭首页</strong>，点一个节点，打开顶部开关，第一次会提示添加 VPN 配置，允许即可。</li>
        </ol>
        <p>
          没有"一键订阅"按钮的机场，就复制订阅链接，在小火箭右上角点"+"，类型选 Subscribe 粘贴进去。全局路由建议选"配置"，国内网站直连、国外走代理。每一步的截图见 <a href="/jiaocheng/shadowrocket-jiaocheng/">Shadowrocket 小火箭使用教程</a>。
        </p>
        <h3>iPhone 用户常踩的两个坑</h3>
        <p>
          <strong>共享 Apple ID</strong>：网上"免费共享美区账号"可能被对方远程锁定设备，或者登录 iCloud 导致资料外泄。自己注册一个外区 ID 只要十几分钟。
        </p>
        <p>
          <strong>"小火箭免费订阅"</strong>：网上分享的免费订阅大多几天就失效，速度没保障，来源也不明。¥15 到 ¥25 的月付套餐就能用一个月，<a href="/pianyi-jichang/">便宜机场推荐</a>里有完整排名。
        </p>
        <h3>不想用小火箭？</h3>
        <p>Quantumult X、Loon、Stash 等也能导入机场订阅，各自的价格和特点见 <a href="/jiaocheng/ios-kehuduan-duibi/">iOS 客户端对比</a>。</p>
      </section>

      <TelegramCta />

      <section class="prose">
        <h2>相关页面</h2>
        <ul>
          <li><a href={PILLAR.path}>机场推荐 {month}：{n} 家机场完整对比</a></li>
          <li><a href="/clash-jichang/">Clash 机场推荐</a>（电脑和安卓）</li>
          <li><a href="/jichang-youhuima/">机场优惠码汇总</a></li>
          <li><a href="/jiaocheng/chatgpt-da-bu-kai/">ChatGPT 打不开怎么办</a></li>
        </ul>
      </section>

      <Faq items={faq} />
      <p class="meta small">页面里的官网链接是推广链接，通过它注册价格不变，本站可能获得佣金。</p>
    </div>
  </div>
</Base>

<style>
  .head {
    max-width: 48rem;
    margin-bottom: 1.25rem;
  }

  .lead {
    color: var(--ink-soft);
  }

  .prep {
    list-style: none;
    counter-reset: s;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    max-width: 52rem;
  }

  @media (max-width: 720px) {
    .prep {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .prep li {
    counter-increment: s;
    display: grid;
    gap: 0.15rem;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    padding: 0.8rem 1rem;
    box-shadow: 4px 4px 0 var(--sign);
  }

  .prep strong::before {
    content: counter(s);
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 0.45rem;
    background: var(--sign);
    border-radius: 50%;
    font-size: 0.875rem;
  }

  .prep span {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .prep a {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .body {
    max-width: 52rem;
    margin-top: 1.5rem;
  }

  .body > section > h2,
  .body .prose h2 {
    border-top: 2px solid var(--ink);
    padding-top: 0.25em;
  }

  .data-table tbody th {
    background: var(--surface);
    color: var(--ink);
    white-space: nowrap;
  }

  tr.is-main td,
  tr.is-main th {
    background: #fffbea !important;
  }

  .nowrap {
    white-space: nowrap;
  }

  .usage ol {
    padding-left: 1.4em;
  }

  .usage li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    align-items: baseline;
    padding: 0.25rem 0;
  }

  .usage li a {
    font-weight: 700;
  }

  .usage li span {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .usage li strong {
    margin-left: auto;
  }

  .usage li.is-main a::after {
    content: '站长主推';
    margin-left: 0.4rem;
    font-size: 0.75rem;
    background: var(--ink);
    color: var(--sign);
    padding: 0 0.35rem;
    border-radius: 3px;
    vertical-align: 0.1em;
  }

  .main-box {
    margin: 0.5rem 0 0;
    padding: 0.25rem 1.25rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--sign);
    border-radius: var(--radius-sm);
  }

  .main-box h2 {
    border-top: 0 !important;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
