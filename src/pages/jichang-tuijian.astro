---
// 机场推荐榜（承接「机场推荐」关键词）：数据全部来自 src/data/profiles 与 affiliate-links.json
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import RankTable from '../components/RankTable.astro';
import Spotlight from '../components/Spotlight.astro';
import HomePicker from '../components/HomePicker.astro';
import TelegramCta from '../components/TelegramCta.astro';
import { PILLAR } from '../site.config';
import { absoluteUrl } from '../lib/content';
import { formatDate } from '../lib/format';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { FEATURED_COUNT, getRanking, isDedicated, isNoRefund, monthLabel, rankingUpdated, type RankedItem } from '../lib/ranking';
import { gb, yuan } from '../lib/profiles';

const all = getRanking();
const featured = all.slice(0, FEATURED_COUNT);
const others = all.slice(FEATURED_COUNT);
const primary = featured[0];
const updated = rankingUpdated(all);
const month = monthLabel(updated);
const year = updated.getFullYear();
const indexable = all.length >= 5;

const testedN = all.filter((i) => i.test).length;
const title = '机场推荐 ' + month + '｜' + testedN + ' 家实测、' + all.length + ' 家机场价格节点与优惠码';
const description = '机场推荐 ' + month + '：' + all.length + ' 家机场的官网套餐价格、后台节点数、IPLC / IEPL 线路和协议放在一张表里比较，' + testedN + ' 家附站长实测速度，含可用优惠码和主推 ' + FEATURED_COUNT + ' 家选购建议，每月更新。';

const crumbs = [
  { name: '首页', path: '/' },
  { name: PILLAR.label, path: PILLAR.path },
];

const by = (key: (i: RankedItem) => number | null) =>
  all.filter((i) => key(i) !== null).sort((a, b) => (key(a) as number) - (key(b) as number));
const cheapestLow = by((i) => i.lowest).slice(0, 5);
const cheapestMonthly = by((i) => i.monthlyFrom).slice(0, 5);
const bestGB = by((i) => i.bestPerGB).slice(0, 5);
const mostNodes = by((i) => (i.nodeTotal === null ? null : -i.nodeTotal)).slice(0, 5);
const iplc = all.filter((i) => isDedicated(i));
const onetime = all.filter((i) => i.hasOnetime);
const noRefund = all.filter((i) => isNoRefund(i));

const pickNote = (i: RankedItem) => {
  const bits: string[] = [];
  if (i.lowest !== null && i.lowestPlanName) bits.push('长期用最省的是「' + i.lowestPlanName + '」，折合约 ' + yuan(i.lowest) + '/月');
  if (i.monthlyFrom !== null) bits.push('想先试一个月，月付最低 ' + yuan(i.monthlyFrom) + (i.monthlyFromGB ? '（每月 ' + gb(i.monthlyFromGB) + '）' : ''));
  if (i.hasOnetime) bits.push('另有不限时流量包，适合用量不固定的人');
  return bits.join('；') + '。';
};

const cheapLowText = cheapestLow.slice(0, 3).map((i) => i.aff.name + '（' + yuan(i.lowest ?? 0) + '/月）').join('、');
const cheapMonthText = cheapestMonthly.slice(0, 3).map((i) => i.aff.name + '（' + yuan(i.monthlyFrom ?? 0) + '）').join('、');
const featuredNames = featured.map((i) => i.aff.name).join('、');
const noRefundNames = noRefund.map((i) => i.aff.name).join('、');
const updatedText = formatDate(updated);

const faq = [
  {
    q: year + ' 年有哪些机场推荐？',
    a: '本站主推 ' + (primary ? primary.aff.name : '') + '，次推依次是：' + featured.slice(1).map((i) => i.aff.name).join('、') + '。完整榜单共 ' + all.length + ' 家，每家都有单独的资料页，写明套餐价格、节点数量、线路和协议。',
  },
  {
    q: '哪个机场最便宜？',
    a: '按 ' + updatedText + ' 整理的官网价格，折合每月最便宜的是 ' + cheapLowText + '，基本都是年付小流量套餐。只想买一个月的话，月付最便宜的是 ' + cheapMonthText + '。价格以官网为准。',
  },
  {
    q: '这些机场有免费试用吗？',
    a: '榜单里的机场都没有免费试用。建议第一次先买最便宜的月付套餐，用一两周确认晚高峰速度和常用网站都正常，再买季付、半年付或年付。',
  },
  {
    q: '买了不满意可以退款吗？',
    a: '多数机场需要提交工单联系客服申请，能否退款以客服答复为准。' + (noRefundNames ? noRefundNames + '在官网标注不提供退款，购买前请留意。' : ''),
  },
  {
    q: 'IPLC 和 IEPL 专线机场有什么好处？',
    a: '专线不走公网出境，晚高峰也比较稳，延迟低，适合看 4K 视频和用 ChatGPT。榜单里多数机场标注了 IPLC 或 IEPL 专线，具体以各家资料页为准。',
  },
  {
    q: '这个榜单多久更新一次？',
    a: '每月更新价格和节点，最近一次更新于 ' + updatedText + '。机场涨价、换线路或停止运营时会及时调整。',
  },
];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '机场推荐 ' + month,
  numberOfItems: all.length,
  itemListElement: all.map((i) => ({
    '@type': 'ListItem',
    position: i.rank,
    name: i.aff.name,
    url: absoluteUrl(i.path),
  })),
};
const jsonLd = [breadcrumbSchema(crumbs), itemList, faqSchema(faq)];
---

<Base title={title} description={description} jsonLd={jsonLd} noindex={!indexable} modified={updated}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <header class="head">
      <h1>机场推荐 {month}</h1>
      <p class="lead">
        本页整理了 {all.length} 家机场的官网套餐价格、后台节点数量、线路类型和协议，每月更新。本站主推 {primary?.aff.name}，第 2 到第 {FEATURED_COUNT} 名为次推，下面逐家写了价格和怎么买最划算；每家都可以点进资料页看全部套餐。
      </p>
      <p class="meta">
        最后更新 <time class="num" datetime={updated.toISOString()}>{formatDate(updated)}</time> · 资料来源：各机场官网套餐页与后台节点列表 · 价格以官网为准
      </p>
    </header>

    {primary && <Spotlight item={primary} />}

    <section aria-labelledby="top-title">
      <h2 id="top-title" class="sec-title">主推与次推 {FEATURED_COUNT} 家机场一览</h2>
      <RankTable items={featured} caption={'主推与次推 ' + FEATURED_COUNT + ' 家机场'} />
      <p class="meta small">"折合最低"按年付等长周期套餐换算成每月价格；表格可以左右滑动。</p>
    </section>

    <HomePicker items={featured} embedded />


    <div class="body">
      {
        featured.map((i) => {
          const p = i.profile;
          return (
            <section class="pick" id={i.aff.id}>
              <h2>
                <span class="num rank">{i.rank}</span>
                <span>{i.aff.name}</span>
                <span class={i.rank === 1 ? 'tier tier--main' : 'tier'}>{i.rank === 1 ? '站长主推' : '次推'}</span>
              </h2>
              <ul class="facts">
                {i.monthlyFrom !== null && <li>月付 <strong class="num">{yuan(i.monthlyFrom)}</strong> 起</li>}
                {i.lowest !== null && <li>折合最低 <strong class="num">{yuan(i.lowest)}</strong>/月</li>}
                {p.lineType && <li>{p.lineType}</li>}
                {i.nodeTotal !== null && <li>{i.nodeTotal} 个节点 · {i.regionCount} 个地区</li>}
                {p.protocols && <li>{p.protocols.join(' / ')}</li>}
                {p.devices && <li>{p.devices}</li>}
              </ul>
              {!!p.regions?.length && (
                <p>
                  <strong>节点地区：</strong>
                  {p.nodeNote ?? p.regions.join('、')}
                </p>
              )}
              <p>
                <strong>官网介绍的特点：</strong>
                {p.claims.slice(0, 3).join('；')}。
              </p>
              <p>
                <strong>怎么买划算：</strong>
                {pickNote(i)}
              </p>
              {p.discounts && (
                <p>
                  <strong>长期付折扣：</strong>
                  {p.discounts}。
                </p>
              )}
              <p class="actions">
                <a class="btn btn--ghost" href={i.path}>
                  查看 {i.aff.name} 全部套餐
                </a>
                <a class="btn" href={i.aff.url} rel="sponsored nofollow noopener" target="_blank">
                  访问 {i.aff.name} 官网
                </a>
              </p>
            </section>
          );
        })
      }

      {
        !!others.length && (
          <section class="more" aria-labelledby="more-title">
            <h2 id="more-title">其他机场（{others.length} 家）</h2>
            <p>下面这些机场也整理了完整资料，按本站推荐顺序排列，点名字可以看全部套餐。</p>
            <RankTable items={others} caption="其他机场" />
          </section>
        )
      }

      <section class="compare prose" aria-labelledby="cmp-title">
        <h2 id="cmp-title">按需求挑机场</h2>
        <p>下面的排名都是按官网价格和后台节点列表直接算出来的，方便按自己的需求快速缩小范围。</p>

        <h3>长期用最省钱（折合每月价格）</h3>
        <p>完整排名和按用量算账，见<a href="/pianyi-jichang/">便宜机场推荐</a>。</p>
        <ol>
          {cheapestLow.map((i) => (
            <li>
              <a href={i.path}>{i.aff.name}</a>：{i.lowestPlanName}，折合约 <span class="num">{yuan(i.lowest ?? 0)}</span>/月
            </li>
          ))}
        </ol>

        <h3>先买一个月试试（月付起价）</h3>
        <ol>
          {cheapestMonthly.map((i) => (
            <li>
              <a href={i.path}>{i.aff.name}</a>：<span class="num">{yuan(i.monthlyFrom ?? 0)}</span>/月{i.monthlyFromGB ? '，每月 ' + gb(i.monthlyFromGB) : ''}
            </li>
          ))}
        </ol>

        <h3>流量用得多（每 GB 最便宜）</h3>
        <ol>
          {bestGB.map((i) => (
            <li>
              <a href={i.path}>{i.aff.name}</a>：最低约 <span class="num">{yuan(i.bestPerGB ?? 0, 3)}</span>/GB
            </li>
          ))}
        </ol>

        <h3>节点最多</h3>
        <ol>
          {mostNodes.map((i) => (
            <li>
              <a href={i.path}>{i.aff.name}</a>：{i.nodeTotal} 个节点，覆盖 {i.regionCount} 个地区
            </li>
          ))}
        </ol>

        {!!onetime.length && <h3>用量不固定，想买不限时流量包</h3>
        <p>价格和限制的详细对比见<a href="/buxianshi-jichang/">不限时流量机场推荐</a>。</p>}
        {!!onetime.length && (
            <p>
              这些机场有一次性购买、不按月清零的流量包：
              {onetime.map((i, k) => (
                <span>{k ? '、' : ''}<a href={i.path}>{i.aff.name}</a></span>
              ))}
              。
            </p>
        )}

        <h3>标注 IPLC / IEPL 专线的机场</h3>
        <p>哪些是全部套餐专线、哪些只有部分套餐是专线，详细分类见<a href="/zhuanxian-jichang/">IPLC / IEPL 专线机场</a>。</p>
        <p>
          {iplc.map((i, k) => (
            <span>{k ? '、' : ''}<a href={i.path}>{i.aff.name}</a></span>
          ))}
          。专线是各家官网的标注，不同套餐的线路可能不一样，以资料页为准。
        </p>
      </section>

      <TelegramCta />

      <section class="guide prose">
        <h2>怎么挑一家适合自己的机场</h2>
        <p>完整的五步挑选法和避开跑路机场的方法，见<a href="/vpn-jichang/">VPN 机场怎么选</a>。</p>
        <h3>先想清楚主要用途</h3>
        <p>
          只是查资料、刷 YouTube，选年付小流量套餐最省钱；经常看 Netflix、Disney+ 的 4K 内容，要选流量大一些的月付套餐；需要用 ChatGPT 等对 IP 敏感的服务，要确认机场有美国、日本、新加坡等地区的节点。
        </p>
        <h3>看懂线路类型</h3>
        <p>
          直连最便宜，但晚高峰最容易慢；中转经过国内服务器再出境，稳定性好一些；IEPL / IPLC 专线不走公网出境，延迟低、高峰期也稳，价格也更高。
        </p>
        <h3>先短后长，别一次买太久</h3>
        <p>
          榜单里的机场都没有免费试用。第一次买先选月付，用满一两周没问题再考虑季付、半年付或年付。机场行业有跑路风险，不建议一次买两三年。
        </p>
        <h3>确认你的设备能用</h3>
        <p>
          榜单里的机场都提供订阅链接：电脑用 <a href="/jiaocheng/clash-verge-rev-jiaocheng/">Clash Verge Rev</a>（注意要用 mihomo 内核的 Clash，详见<a href="/clash-jichang/">Clash 机场推荐</a>） 或 <a href="/jiaocheng/v2rayn-jiaocheng/">v2rayN</a>，iPhone 用 <a href="/jiaocheng/shadowrocket-jiaocheng/">Shadowrocket</a>（需要<a href="/jiaocheng/waiqu-apple-id-zhuce/">外区 Apple ID</a>），安卓用 <a href="/jiaocheng/clash-meta-for-android-jiaocheng/">Clash Meta for Android</a>。
        </p>
      </section>

      <section class="method prose">
        <h2>资料来源与排序说明</h2>
        <ul>
          <li>价格、套餐和官方介绍来自各机场官网套餐页；节点数量和协议以机场后台的节点列表为准，和官网宣传不一致时，资料页里会写明。</li>
          <li>排名是本站的推荐顺序。已实测的机场在表格里标有"已实测"，资料页附测速原图；其余机场会陆续补测。</li>
          <li>页面里的官网链接是推广链接，通过它注册价格不变，本站可能获得佣金。</li>
          <li>想直接找官网入口，可以看<a href="/jichang-daohang/">机场官网导航</a>。</li>
        </ul>
      </section>

      <Faq items={faq} />
    </div>
  </div>
</Base>

<style>
  .head {
    max-width: 48rem;
    margin-bottom: 1.5rem;
  }

  .lead {
    color: var(--ink-soft);
  }

  .sec-title {
    margin-top: 1rem;
    border-top: 2px solid var(--ink);
    padding-top: 0.25em;
  }

  .small {
    margin-top: 0.25rem;
  }

  .body {
    max-width: var(--measure);
    margin-top: 2.5rem;
  }

  .pick {
    padding-bottom: 1.25rem;
  }

  .pick h2 {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    border-top: 2px solid var(--ink);
    padding-top: 0.5em;
  }

  .rank {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-width: 2.2rem;
    height: 2.2rem;
    background: var(--sign);
    border-radius: var(--radius-sm);
    font-size: 1.4rem;
    font-weight: 700;
  }

  .tier {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--muted);
  }

  .tier--main {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--sign);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .facts li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.1rem 0.6rem;
    font-size: 0.9375rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .more h2 {
    border-top: 2px solid var(--ink);
    padding-top: 0.25em;
  }
</style>
