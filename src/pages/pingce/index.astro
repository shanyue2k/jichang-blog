---
// 机场实测：汇总所有有站长实测的机场（数据来自资料文件 tests / topology）
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TelegramCta from '../../components/TelegramCta.astro';
import { SECTIONS } from '../../site.config';
import { breadcrumbSchema } from '../../lib/schema';
import { getRanking, monthLabel, rankingUpdated } from '../../lib/ranking';
import { yuan } from '../../lib/profiles';

const meta = SECTIONS.pingce;
const all = getRanking();
const tested = all.filter((i) => i.test);
const topoOnly = all.filter((i) => !i.test && i.profile.topology);
const untested = all.length - tested.length;
const crumbs = [
  { name: '首页', path: '/' },
  { name: meta.label, path: '/pingce/' },
];
---

<Base title={'机场测速 ' + monthLabel(rankingUpdated(all)) + '｜' + tested.length + ' 家机场实测速度、延迟与流媒体解锁结果'} description={meta.description} jsonLd={[breadcrumbSchema(crumbs)]} noindex={tested.length === 0}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <header class="head">
      <h1>机场测速：站长实测结果</h1>
      <p class="lead">
        这里只放站长用自己购买的订阅、通过测速机器人实际测过的机场。目前实测了 {tested.length} 家，其余 {untested} 家暂时只有官网和后台整理的资料，资料页会写明"尚未实测"，不会拿别人的测速图充数。
      </p>
      <p class="meta">每份测试都写明日期、测试服务器和工具，并附原始截图。测试方法见<a href="/ceping-fangfa/">测评方法</a>。</p>
    </header>

    <ul class="cards">
      {tested.map((i) => {
        const t = i.test!;
        return (
          <li class={i.rank === 1 ? 'main' : ''}>
            <div class="c-head">
              <h2><a href={i.path + '#test-title'}>{i.aff.name}</a>{i.rank === 1 && <span class="badge">站长主推</span>}</h2>
              <span class="c-date">{t.date} 实测</span>
            </div>
            <p class="c-env">{t.env} · {t.time && Number(t.time.slice(0, 2)) >= 20 ? '晚高峰' : '非晚高峰'}</p>
            <ul class="c-rows">
              {t.regions.map((r) => (
                <li>
                  <span>{r.name}</span>
                  <span class="num">{r.avgMBps} MB/s</span>
                  <span class="num rtt">{r.medianRttMs} ms</span>
                </li>
              ))}
            </ul>
            {t.unlock && <p class="c-unlock">{Object.entries(t.unlock).map(([k, v]) => k + ' ' + v).join(' · ')}</p>}
            <p class="c-foot">
              月付 {yuan(i.monthlyFrom ?? 0)} 起{i.aff.coupon ? ' · 优惠码 ' + i.aff.coupon : ''}
              <a href={i.path + '#test-title'}>看完整实测 →</a>
            </p>
          </li>
        );
      })}
    </ul>

    {!!topoOnly.length && (
      <section class="topo">
        <h2>只有节点出口分析的机场</h2>
        <p>下面这些机场只做过节点拓扑分析（入口、出口服务商），没有测速和解锁，不算实测：</p>
        <ul>
          {topoOnly.map((i) => (
            <li><a href={i.path + '#topo-title'}>{i.aff.name}</a>（{i.profile.topology!.date}）</li>
          ))}
        </ul>
      </section>
    )}

    <section class="next">
      <h2>还没实测的机场怎么看</h2>
      <p>
        没实测的机场，可以先看资料页的"资料核对分"：它比对官网宣传和后台实际，看资料透不透明、说法一不一致（不代表速度）。也可以在<a href="/jichang-tuijian/">机场推荐榜</a>里按价格、线路、节点筛选。无论哪家，第一次都建议先买月付试用。
      </p>
    </section>

    <TelegramCta />
  </div>
</Base>

<style>
  .head {
    max-width: 48rem;
    margin-bottom: 1.25rem;
  }

  .lead {
    color: var(--ink-soft);
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }

  .cards > li {
    padding: 1rem 1.1rem 0.8rem;
    background: var(--slate);
    color: #e6eaee;
    border-radius: var(--radius-md);
  }

  .cards > li.main {
    box-shadow: 5px 5px 0 var(--sign);
  }

  .c-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cards h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .cards h2 a {
    color: #fff;
    text-decoration: none;
  }

  .badge {
    margin-left: 0.4rem;
    padding: 0 0.4rem;
    background: var(--sign);
    color: var(--sign-ink);
    border-radius: 3px;
    font-size: 0.75rem;
    vertical-align: 0.2em;
  }

  .c-date {
    font-size: 0.8125rem;
    color: var(--sign);
    font-weight: 700;
    white-space: nowrap;
  }

  .c-env {
    margin: 0.15rem 0 0.5rem;
    font-size: 0.8125rem;
    color: #aab4be;
  }

  .c-rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .c-rows li {
    display: grid;
    grid-template-columns: 1fr auto 4rem;
    gap: 0.5rem;
    padding: 0.3rem 0;
    border-top: 1px solid #33404d;
    font-size: 0.9375rem;
  }

  .c-rows .num {
    text-align: right;
    color: var(--sign);
    font-weight: 600;
  }

  .c-rows .rtt {
    color: #aab4be;
    font-weight: 400;
  }

  .c-unlock {
    margin: 0.5rem 0;
    font-size: 0.8125rem;
    color: #b9f0cf;
  }

  .c-foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.8125rem;
    color: #cfd6dd;
  }

  .c-foot a {
    color: var(--sign);
    font-weight: 600;
  }

  .topo,
  .next {
    max-width: 52rem;
    margin-top: 2rem;
  }

  .topo h2,
  .next h2 {
    border-top: 2px solid var(--ink);
    padding-top: 0.25em;
    font-size: var(--step-1);
  }
</style>
