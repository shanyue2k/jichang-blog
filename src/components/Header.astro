---
import { PILLAR, SECTION_KEYS, SECTIONS, SITE } from '../site.config';

const current = Astro.url.pathname;
const links = [
  { href: PILLAR.path, label: PILLAR.label },
  { href: '/jichang-youhuima/', label: '机场优惠码' },
  ...SECTION_KEYS.map((k) => ({ href: `/${k}/`, label: SECTIONS[k].label })),
];
const isActive = (href: string) => current === href || current.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} 首页`}>
      <img class="mark" src="/logo-mark.svg" width="36" height="36" alt="" />
      <span class="brand-name">机场<span class="hao">好</span></span>
    </a>
  </div>
  <nav class="wayfinding" aria-label="主栏目">
    <ul class="wrap">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--slate);
    color: #fff;
  }

  .bar {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
  }

  .mark {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    box-shadow: 0 0 0 1px rgba(62, 231, 255, 0.25), 0 0 14px rgba(255, 204, 0, 0.18);
  }

  .brand:hover .mark {
    box-shadow: 0 0 0 1px rgba(62, 231, 255, 0.5), 0 0 18px rgba(255, 204, 0, 0.35);
  }

  .hao {
    color: var(--sign);
  }

  /* 导视条：机场里那条黄色指示牌 */
  .wayfinding {
    background: var(--sign);
    color: var(--sign-ink);
  }

  .wayfinding ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0 auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .wayfinding ul::-webkit-scrollbar {
    display: none;
  }

  .wayfinding a {
    display: block;
    padding: 0.6rem 0.9rem;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
  }

  .wayfinding li:first-child a {
    padding-left: 0;
  }

  .wayfinding a:hover {
    border-bottom-color: var(--sign-ink);
  }

  .wayfinding a[aria-current='page'] {
    border-bottom-color: var(--sign-ink);
  }
</style>
