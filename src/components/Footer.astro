---
import { PILLAR, SECTION_KEYS, SECTIONS, SITE } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">{SITE.name}</p>
      <p class="small">{SITE.description}</p>
      <p class="tg">
        <a href={SITE.telegram.channel} rel="noopener" target="_blank">机场好 Telegram 频道</a>
        <span aria-hidden="true">·</span>
        <a href={SITE.telegram.group} rel="noopener" target="_blank">交流群</a>
      </p>
    </div>
    <nav aria-label="栏目">
      <ul>
        <li><a href={PILLAR.path}>{PILLAR.label}</a></li>
        <li><a href="/pianyi-jichang/">便宜机场推荐</a></li>
        <li><a href="/buxianshi-jichang/">不限时流量机场</a></li>
        <li><a href="/jichang-youhuima/">机场优惠码</a></li>
        <li><a href="/zhuanxian-jichang/">IPLC / IEPL 专线机场</a></li>
        <li><a href="/clash-jichang/">Clash 机场推荐</a></li>
        <li><a href="/xiaohuojian-jichang/">小火箭机场推荐</a></li>
        <li><a href="/jichang-daohang/">机场官网导航</a></li>
        {SECTION_KEYS.map((k) => <li><a href={`/${k}/`}>{SECTIONS[k].label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="关于本站">
      <ul>
        <li><a href="/ceping-fangfa/">测评方法</a></li>
        <li><a href="/about/">关于与声明</a></li>
        <li><a href="/rss.xml">RSS 订阅</a></li>
        <li><a href="/sitemap.xml">网站地图</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap small legal">
    <p>
      © {year} {SITE.name}。部分链接为推广链接，通过它购买不会让你多付钱，本站可能获得佣金；请遵守所在地法律法规使用网络服务。
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--slate);
    color: #c9d1da;
    padding: 3rem 0 2rem;
  }

  .grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 2fr 1fr 1fr;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .grid > div {
      grid-column: 1 / -1;
    }
  }

  .tg {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .tg a {
    color: var(--sign);
    font-weight: 600;
  }

  .name {
    color: #fff;
    font-weight: 700;
    margin-bottom: 0.4em;
  }

  .small {
    font-size: var(--step--1);
    line-height: 1.7;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li + li {
    margin-top: 0.35em;
  }

  a {
    color: #fff;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .legal {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--slate-2);
    color: #9aa6b2;
  }
</style>
